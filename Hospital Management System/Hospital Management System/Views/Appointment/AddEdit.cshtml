@model AppointmentModel
@{
    ViewData["Title"] = Model?.AppointmentID == null ? "Add Appointment" : "Edit Appointment";
}

<div class="pagetitle">
    <h1>@ViewData["Title"]</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="dashboard" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Appointment" asp-action="Index">Appointments</a></li>
            <li class="breadcrumb-item active">@ViewData["Title"]</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Appointment Information</h5>

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form class="row g-3" asp-controller="Appointment" asp-action="AppointmentSave" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <input asp-for="AppointmentID" type="hidden" />

                        <div class="col-md-6">
                            <label asp-for="DoctorID" class="form-label">Doctor</label>
                            <select asp-for="DoctorID" asp-items="ViewBag.DoctorList" class="form-select">
                                <option value="">-- Select Doctor --</option>
                            </select>
                            <span asp-validation-for="DoctorID" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PatientID" class="form-label">Patient</label>
                            <select asp-for="PatientID" asp-items="ViewBag.PatientList" class="form-select">
                                <option value="">-- Select Patient --</option>
                            </select>
                            <span asp-validation-for="PatientID" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AppointmentDate" class="form-label">Appointment Date & Time</label>
                            <input asp-for="AppointmentDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="AppointmentDate" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="AppointmentStatus" class="form-label">Status</label>
                            <select asp-for="AppointmentStatus" asp-items="ViewBag.StatusList" class="form-select">
                                <option value="">-- Select Status --</option>
                            </select>
                            <span asp-validation-for="AppointmentStatus" class="text-danger"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter appointment description or reason for visit"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="col-md-12">
                            <label asp-for="SpecialRemarks" class="form-label">Special Remarks</label>
                            <textarea asp-for="SpecialRemarks" class="form-control" rows="2" placeholder="Any special instructions or remarks"></textarea>
                            <span asp-validation-for="SpecialRemarks" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TotalConsultedAmount" class="form-label">Consultation Amount</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-currency-rupee"></i></span>
                                <input asp-for="TotalConsultedAmount" type="number" step="0.01" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="TotalConsultedAmount" class="text-danger"></span>
                        </div>

                        <input asp-for="UserID" type="hidden" />

                        <div class="text-center">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Save Appointment
                            </button>
                            <a asp-controller="Appointment" asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Set minimum date to today for new appointments
            const appointmentDateInput = document.querySelector('input[name="AppointmentDate"]');
            if (appointmentDateInput && !appointmentDateInput.value) {
                const now = new Date();
                now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
                appointmentDateInput.min = now.toISOString().slice(0, 16);
            }
        });
    </script>
}