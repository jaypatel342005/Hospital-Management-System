@using System.Data
@model DataTable

@{
    ViewData["Title"] = "Appointment Details";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var appointmentData = (DataTable)Model;
    var appointmentRow = appointmentData.Rows[0];

    var patientTable = (DataTable)ViewData["PatientTable"];
    var patientRow = patientTable.Rows[0];

    var doctorTable = (DataTable)ViewData["DoctorTable"];
    var doctorRow = doctorTable.Rows[0];

    var previousAppointmentsTable = (DataTable)ViewData["PreviousAppointmentsTable"];
    var medicalRecordsTable = (DataTable)ViewData["MedicalRecordsTable"];
    var billingTable = (DataTable)ViewData["BillingTable"];
    var doctorDepartmentTable = (DataTable)ViewData["DoctorDepartmentTable"];

    var patientAge = (int)ViewData["PatientAge"];
    var appointmentID = (int)ViewData["AppointmentID"];

    string patientInitials = patientRow["Name"].ToString().Split(' ')
        .Select(n => n.Length > 0 ? n[0].ToString() : "")
        .Aggregate((a, b) => a + b).ToUpper();

    string doctorInitials = doctorRow["Name"].ToString()
        .Replace("Dr. ", "", StringComparison.OrdinalIgnoreCase)
        .Replace("Dr ", "", StringComparison.OrdinalIgnoreCase)
        .Split(' ')
        .Where(n => !string.IsNullOrWhiteSpace(n))
        .Select(n => n[0].ToString())
        .Aggregate((a, b) => a + b).ToUpper();

    string departmentInfo = doctorDepartmentTable.Rows.Count > 0
        ? doctorDepartmentTable.Rows[0]["DepartmentName"].ToString()
        : "General";
}

<div class="pagetitle">
    <h1>Appointment Details</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/dashboard">Home</a></li>
            <li class="breadcrumb-item"><a href="/Appointment">Appointments</a></li>
            <li class="breadcrumb-item active">Details</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-xl-8">
            <!-- Main Details Card -->
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="card-title">Appointment Information</h5>
                        <div class="d-flex gap-2">
                            @* <a asp-controller="Appointment"
                               asp-action="AppointmentEdit"
                               asp-route-appointmentID="@appointmentID"
                               class="btn btn-primary btn-sm">
                                <i class="bi bi-pencil"></i> Edit
                            </a> *@
                            @Html.EncodedActionLink("Edit", "AppointmentEdit", "Appointment", new { appointmentID = appointmentID }, new { @class = "btn btn-primary btn-sm" }, "bi bi-pencil")

                            @if (appointmentRow["AppointmentStatus"].ToString() == "Scheduled")
                            {
                                <button class="btn btn-danger btn-sm" onclick="confirmDelete(@appointmentRow["AppointmentID"])">
                                    <i class="bi bi-x-circle"></i> Cancel
                                </button>
                            }
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-lg-6">
                            <div class="info-group mb-3">
                                <label class="fw-bold">Appointment ID</label>
                                <p>@appointmentRow["AppointmentID"].ToString()</p>
                            </div>
                            <div class="info-group mb-3">
                                <label class="fw-bold">Date & Time</label>
                                <p>@Convert.ToDateTime(appointmentRow["AppointmentDate"]).ToString("MMMM dd, yyyy 'at' hh:mm tt")</p>
                            </div>
                            <div class="info-group mb-3">
                                <label class="fw-bold">Description</label>
                                <p>@appointmentRow["Description"]</p>
                            </div>
                            <div class="info-group mb-3">
                                <label class="fw-bold">Status</label>
                                <p>
                                    @{
                                        string status = appointmentRow["AppointmentStatus"].ToString();
                                        string badgeClass = status switch
                                        {
                                            "Scheduled" => "bg-warning",
                                            "Completed" => "bg-success",
                                            "Cancelled" => "bg-danger",
                                            "In Progress" => "bg-info",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass">@status</span>
                                </p>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            @if (appointmentRow["TotalConsultedAmount"] != DBNull.Value)
                            {
                                <div class="info-group mb-3">
                                    <label class="fw-bold">Consultation Amount</label>
                                    <p>₹@Convert.ToDecimal(appointmentRow["TotalConsultedAmount"]).ToString("N2")</p>
                                </div>
                            }
                            <div class="info-group mb-3">
                                <label class="fw-bold">Department</label>
                                <p>@departmentInfo</p>
                            </div>
                            <div class="info-group mb-3">
                                <label class="fw-bold">Created On</label>
                                <p>@Convert.ToDateTime(appointmentRow["Created"]).ToString("MMMM dd, yyyy")</p>
                            </div>
                            <div class="info-group mb-3">
                                <label class="fw-bold">Last Updated</label>
                                <p>@Convert.ToDateTime(appointmentRow["Modified"]).ToString("MMMM dd, yyyy")</p>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <label class="fw-bold">Special Remarks</label>
                        <p>@(string.IsNullOrEmpty(appointmentRow["SpecialRemarks"].ToString()) ? "No special remarks" : appointmentRow["SpecialRemarks"])</p>
                    </div>
                </div>
            </div>


            <!-- Billing Information Card -->
            @if (billingTable.Rows.Count > 0)
            {
                var billingRow = billingTable.Rows[0];
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Billing Information</h5>
                        <div class="row">
                            <div class="col-md-3">
                                <div class="info-group mb-3">
                                    <label class="fw-bold">Bill Amount</label>
                                    <p class="text-primary">₹@Convert.ToDecimal(billingRow["BillAmount"]).ToString("N2")</p>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="info-group mb-3">
                                    <label class="fw-bold">Paid Amount</label>
                                    <p class="text-success">₹@Convert.ToDecimal(billingRow["PaidAmount"]).ToString("N2")</p>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="info-group mb-3">
                                    <label class="fw-bold">Balance Amount</label>
                                    <p class="text-danger">₹@Convert.ToDecimal(billingRow["BalanceAmount"]).ToString("N2")</p>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="info-group mb-3">
                                    <label class="fw-bold">Payment Status</label>
                                    <p>
                                        @{
                                            string paymentStatus = billingRow["PaymentStatus"].ToString();
                                            string paymentBadgeClass = paymentStatus switch
                                            {
                                                "Paid" => "bg-success",
                                                "Partial" => "bg-warning",
                                                "Unpaid" => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @paymentBadgeClass">@paymentStatus</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Medical History Card -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Related Medical History</h5>
                    <div class="timeline">
                        @if (medicalRecordsTable.Rows.Count > 0)
                        {
                            @foreach (DataRow record in medicalRecordsTable.Rows)
                            {
                                <div class="timeline-item">
                                    <div class="timeline-marker bg-primary"></div>
                                    <div class="timeline-content">
                                        <h6>Medical Record - @record["DoctorName"]</h6>
                                        <small class="text-muted">@Convert.ToDateTime(record["VisitDate"]).ToString("MMMM dd, yyyy") - @record["DoctorSpecialization"]</small>
                                        <p><strong>Diagnosis:</strong> @record["Diagnosis"]</p>
                                        @if (!string.IsNullOrEmpty(record["Treatment"].ToString()))
                                        {
                                            <p><strong>Treatment:</strong> @record["Treatment"]</p>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        @if (previousAppointmentsTable.Rows.Count > 0)
                        {
                            @foreach (DataRow appointment in previousAppointmentsTable.Rows)
                            {
                                <div class="timeline-item">
                                    <div class="timeline-marker bg-info"></div>
                                    <div class="timeline-content">
                                        <h6>Previous Appointment - @appointment["DoctorName"]</h6>
                                        <small class="text-muted">@Convert.ToDateTime(appointment["AppointmentDate"]).ToString("MMMM dd, yyyy") - @appointment["DoctorSpecialization"]</small>
                                        <p>@appointment["Description"]</p>
                                        @if (!string.IsNullOrEmpty(appointment["SpecialRemarks"].ToString()))
                                        {
                                            <p><strong>Remarks:</strong> @appointment["SpecialRemarks"]</p>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        @if (medicalRecordsTable.Rows.Count == 0 && previousAppointmentsTable.Rows.Count == 0)
                        {
                            <p class="text-muted">No medical history available for this patient.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <!-- Patient Information Card -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Patient Information</h5>
                    <div class="d-flex flex-column align-items-center">
                        <div class="avatar-lg mb-3">
                            <span class="avatar-title rounded-circle bg-primary text-white fs-2">
                                @patientInitials
                            </span>
                        </div>
                        <h6 class="mb-0">@patientRow["Name"]</h6>
                        <small class="text-muted mb-3">@patientRow["PatientID"].ToString()</small>
                        <!-- <a asp-controller="Patient"
                           asp-action="Details"
                           asp-route-PatientID="@patientRow["PatientID"]"
                           class="btn btn-outline-primary btn-sm">
                            View Full Profile
                        </a> -->
                        @Html.EncodedActionLink("View Full Profile", "Details", "Patient", new { PatientID = patientRow["PatientID"] }, new { @class = "btn btn-outline-primary btn-sm" }, "")

                    </div>
                    <hr>
                    <div class="patient-details mt-3">
                        <div class="info-group mb-2">
                            <label class="fw-bold">Age</label>
                            <p>@patientAge Years</p>
                        </div>
                        <div class="info-group mb-2">
                            <label class="fw-bold">Gender</label>
                            <p>@patientRow["Gender"]</p>
                        </div>
                        <div class="info-group mb-2">
                            <label class="fw-bold">Phone</label>
                            <p>@patientRow["Phone"]</p>
                        </div>
                        <div class="info-group mb-2">
                            <label class="fw-bold">Email</label>
                            <p>@patientRow["Email"]</p>
                        </div>
                        <div class="info-group mb-2">
                            <label class="fw-bold">Address</label>
                            <p>@patientRow["Address"], @patientRow["City"], @patientRow["State"]</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Doctor Information Card -->
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Doctor Information</h5>
                    <div class="d-flex flex-column align-items-center">
                        <div class="avatar-lg mb-3">
                            <span class="avatar-title rounded-circle bg-info text-white fs-2">
                                @doctorInitials
                            </span>
                        </div>
                        <h6 class="mb-0">@doctorRow["Name"]</h6>
                        <small class="text-muted mb-2">@doctorRow["Specialization"]</small>

                       <!-- <a asp-controller="Doctor"
                           asp-action="Details"
                           asp-route-DoctorID="@doctorRow["DoctorID"]"
                           class="btn btn-outline-primary btn-sm">
                            View Full Profile
                         </a> -->
                        @Html.EncodedActionLink("View Full Profile", "Details", "Doctor", new { DoctorID = doctorRow["DoctorID"] }, new { @class = "btn btn-outline-primary btn-sm" }, "")

                       
                    </div>
                    <hr>
                    <div class="doctor-details mt-3">
                        <div class="info-group mb-2">
                            <label class="fw-bold">Specialization</label>
                            <p>@doctorRow["Specialization"]</p>
                        </div>
                        <div class="info-group mb-2">
                            <label class="fw-bold">Qualification</label>
                            <p>@doctorRow["Qualification"]</p>
                        </div>
                        <div class="info-group mb-2">
                            <label class="fw-bold">Department</label>
                            <p>@departmentInfo</p>
                        </div>
                        <div class="info-group mb-2">
                            <label class="fw-bold">Contact</label>
                            <p>@doctorRow["Phone"]</p>
                        </div>
                        <div class="info-group mb-2">
                            <label class="fw-bold">Email</label>
                            <p>@doctorRow["Email"]</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .avatar-lg {
        width: 80px;
        height: 80px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .avatar-title {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .info-group label {
        display: block;
        margin-bottom: 0.2rem;
        color: #6c757d;
        font-size: 0.9rem;
    }

    .info-group p {
        margin-bottom: 0;
        font-weight: 500;
    }

    .timeline {
        position: relative;
        padding-left: 2rem;
    }

        .timeline::before {
            content: '';
            position: absolute;
            left: 0.75rem;
            top: 0;
            bottom: 0;
            width: 2px;
            background-color: #dee2e6;
        }

    .timeline-item {
        position: relative;
        margin-bottom: 1.5rem;
    }

    .timeline-marker {
        position: absolute;
        left: -1.5rem;
        top: 0.25rem;
        width: 1rem;
        height: 1rem;
        border-radius: 50%;
        border: 2px solid #fff;
    }

    .timeline-content {
        background-color: #f8f9fa;
        padding: 1rem;
        border-radius: 0.375rem;
        margin-left: 0.5rem;
    }

        .timeline-content h6 {
            margin-bottom: 0.5rem;
            color: #495057;
        }

        .timeline-content p {
            margin-bottom: 0.5rem;
        }

            .timeline-content p:last-child {
                margin-bottom: 0;
            }
</style>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>

    <script>
        window.onload = function () {
            @if (TempData["SuccessMessage"] != null)
            {
                    <text>
                    Swal.fire({
                        icon: 'success',
                        title: 'Success',
                        text: '@TempData["SuccessMessage"]'
                    });
                    </text>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                    <text>
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: '@TempData["ErrorMessage"]'
                    });
                    </text>
            }
        };

        function confirmDelete(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you really want to cancel this appointment?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, cancel it!',
                cancelButtonText: 'No, keep it'
            }).then((result) => {
                if (result.isConfirmed) {
                    // Updated URL for appointment cancellation
                    window.location.href = `/Appointment/AppointmentDelete?AppointmentID=${id}`;
                }
            });
        }
    </script>
}
