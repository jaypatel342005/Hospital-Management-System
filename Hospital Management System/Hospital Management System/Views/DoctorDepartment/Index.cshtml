@model System.Data.DataTable
@using System.Data
@{
    ViewData["Title"] = "Doctor Departments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="pagetitle">
    <h1>Doctor Departments</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "dashboard")">Home</a></li>
            <li class="breadcrumb-item active">Doctor Departments</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <!-- Header Section -->
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
                        <h5 class="card-title mb-3 mb-md-0">Doctor Department Associations</h5>
                        <div class="d-flex flex-column flex-sm-row gap-2">
                            <a href="@Url.Action("AddEdit", "DoctorDepartment")" class="btn btn-primary">
                                <i class="bi bi-plus-circle"></i>
                                <span class="d-none d-sm-inline">Add New Association</span>
                                <span class="d-inline d-sm-none">Add</span>
                            </a>
                            
                        </div>
                    </div>

                    <!-- Filter Section (Collapsible) -->
                    @* <div class="collapse" id="filterSection">
                        <div class="card card-body bg-light mb-3">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label for="doctorFilter" class="form-label">Doctor Filter</label>
                                    <select class="form-select" id="doctorFilter">
                                        <option value="">All Doctors</option>
                                        @{
                                            var doctors = Model.AsEnumerable().Select(row => new
                                            {
                                                Name = row.Field<string>("DoctorName")
                                            }).Distinct().OrderBy(x => x.Name);
                                        }
                                        @foreach (var doctor in doctors)
                                        {
                                            <option value="@doctor.Name">@doctor.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label for="departmentFilter" class="form-label">Department Filter</label>
                                    <select class="form-select" id="departmentFilter">
                                        <option value="">All Departments</option>
                                        @{
                                            var departments = Model.AsEnumerable().Select(row => new
                                            {
                                                Name = row.Field<string>("DepartmentName")
                                            }).Distinct().OrderBy(x => x.Name);
                                        }
                                        @foreach (var department in departments)
                                        {
                                            <option value="@department.Name">@department.Name</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4 d-flex align-items-end">
                                    <button class="btn btn-outline-primary me-2" onclick="applyFilters()">Apply</button>
                                    <button class="btn btn-outline-secondary" onclick="clearFilters()">Clear</button>
                                </div>
                            </div>
                        </div>
                    </div> *@



                    <!-- Mobile Cards View (Hidden on larger screens) -->
                    <div class="d-block d-lg-none">
                        <div class="row" id="mobileCards">
                            @foreach (DataRow dataRow in Model.Rows)
                            {
                                <div class="col-12 col-md-6 mb-3">
                                    <div class="card h-100">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <h6 class="card-title text-primary">@dataRow["DoctorName"]</h6>
                                            </div>
                                            <p class="card-text"><strong>Department:</strong> @dataRow["DepartmentName"]</p>
                                            <p class="card-text text-muted small"><strong>User:</strong> @dataRow["UserName"]</p>
                                            <div class="row text-muted small mb-3">
                                                <div class="col-6">
                                                    <strong>Created:</strong><br>
                                                    @DateTime.Parse(dataRow["Created"].ToString()).ToString("MMM dd, yyyy")
                                                </div>
                                                <div class="col-6">
                                                    <strong>Modified:</strong><br>
                                                    @DateTime.Parse(dataRow["Modified"].ToString()).ToString("MMM dd, yyyy")
                                                </div>
                                            </div>
                                            <div class="d-flex gap-2">
                                             
                                                @* <a class="btn btn-outline-primary btn-sm flex-fill" asp-controller="DoctorDepartment" asp-action="DoctorDepartmentEdit" asp-route-DoctorDepartmentID="@dataRow["DoctorDepartmentID"]">
                                                    <i class="bi bi-pencil"></i>Edit
                                                </a> *@
                                                @Html.EncodedActionLink("Edit", "DoctorDepartmentEdit", "DoctorDepartment", new { DoctorDepartmentID = dataRow["DoctorDepartmentID"] }, new { @class = "btn btn-outline-primary btn-sm flex-fill" }, "bi bi-pencil")                  
                                                <button class="btn btn-outline-danger btn-sm"
                                                        onclick="confirmDelete(@dataRow["DoctorDepartmentID"])" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Desktop Table View (Hidden on smaller screens) -->
                    <div class="d-none d-lg-block">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover datatable" id="doctorDepartmentsTable">
                                <thead class="table-dark">
                                    <tr>
                                       
                                        <th>Doctor Name</th>
                                        <th>Department Name</th>
                                        <th>User</th>
                                        <th>Created</th>
                                        <th>Modified</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (DataRow dataRow in Model.Rows)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold text-primary">@dataRow["DoctorName"]</div>
                                            </td>
                                            <td>
                                                <div class="fw-semibold">@dataRow["DepartmentName"]</div>
                                            </td>
                                            <td>
                                                <span class="text-muted">@dataRow["UserName"]</span>
                                            </td>
                                            <td>
                                                <small class="text-muted">
                                                    @DateTime.Parse(dataRow["Created"].ToString()).ToString("MMM dd, yyyy")
                                                </small>
                                            </td>
                                            <td>
                                                <small class="text-muted">
                                                    @DateTime.Parse(dataRow["Modified"].ToString()).ToString("MMM dd, yyyy")
                                                </small>
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    @* <a href="@Url.Action("Details", "DoctorDepartment", new { id = dataRow["DoctorDepartmentID"] })"
                                                       class="btn btn-outline-info btn-sm" title="View Details">
                                                        <i class="bi bi-info-circle"></i>
                                                    </a> *@
                                                    @* <a class="btn btn-outline-primary btn-sm" title="Edit" asp-controller="DoctorDepartment" asp-action="DoctorDepartmentEdit" asp-route-DoctorDepartmentID="@dataRow["DoctorDepartmentID"]">
                                                        <i class="bi bi-pencil"></i>
                                                    </a> *@
                                                    @Html.EncodedActionLink("", "DoctorDepartmentEdit", "DoctorDepartment", new { DoctorDepartmentID = dataRow["DoctorDepartmentID"] }, new { @class = "btn btn-outline-primary btn-sm", title = "Edit" }, "bi bi-pencil")
                                                    <button class="btn btn-outline-danger btn-sm"
                                                            onclick="confirmDelete(@dataRow["DoctorDepartmentID"])" title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Empty State -->
                    @if (Model.Rows.Count == 0)
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-person-plus display-1 text-muted"></i>
                            <h4 class="mt-3">No Doctor-Department Associations Found</h4>
                            <p class="text-muted">Get started by creating your first doctor-department association.</p>
                            <a href="@Url.Action("AddEdit", "DoctorDepartment")" class="btn btn-primary">
                                <i class="bi bi-plus-circle"></i> Add Association
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        window.onload = function () {
            @if (TempData["SuccessMessage"] != null)
            {
                        <text>
                        Swal.fire({
                            icon: 'success',
                            title: 'Success',
                            text: '@TempData["SuccessMessage"]'
                        });
                        </text>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                        <text>
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: '@TempData["ErrorMessage"]'
                        });
                        </text>
            }
        };

        function confirmDelete(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Do you really want to delete this doctor-department association?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = `/DoctorDepartment/DoctorDepartmentDelete?DoctorDepartmentID=${id}`;
                }
            });
        }


        // Initialize DataTable for desktop view
        document.addEventListener('DOMContentLoaded', function() {
            if (window.innerWidth >= 992) {
                $('#doctorDepartmentsTable').DataTable({
                    responsive: true,
                    pageLength: 10,
                    order: [[0, 'desc']],
                    columnDefs: [
                        { orderable: false, targets: [6] }
                    ]
                });
            }
        });
    </script>
}

<style>
    .text-truncate {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .btn-group .btn {
        border-radius: 0;
    }

    .table th {
        background-color: #c0c0c0;
        font-size: 1.2rem;
    }

        .btn-group .btn:first-child {
            border-top-left-radius: 0.375rem;
            border-bottom-left-radius: 0.375rem;
        }

        .btn-group .btn:last-child {
            border-top-right-radius: 0.375rem;
            border-bottom-right-radius: 0.375rem;
        }
</style>