@model DepartmentsModel
@{
    ViewData["Title"] = Model?.DepartmentID == null || Model.DepartmentID <= 0 ? "Add Department" : "Edit Department";
}
<div class="pagetitle">
    <h1>@ViewData["Title"]</h1>
</div>
<section class="section">
    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Department Information</h5>
                    <form method="post" asp-controller="Department" asp-action="DepartmentSave">
                        <input asp-for="DepartmentID" type="hidden" />
                        <div class="mb-3">
                            <label asp-for="DepartmentName" class="form-label">Department Name</label>
                            <input asp-for="DepartmentName" type="text" class="form-control" required>
                            <span asp-validation-for="DepartmentName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="mb-3">
                            <label asp-for="IsActive" class="form-label">Status</label>
                            <select asp-for="IsActive" class="form-control" required>
                                <option value="">Select Status</option>
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                            <span asp-validation-for="IsActive" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="UserID" class="form-label fw-bold">Created By (User)</label>
                            <select asp-for="UserID" class="form-select" asp-items="ViewBag.UserList">
                                <option value="">-- Select User --</option>
                            </select>
                            <span asp-validation-for="UserID" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a href="@Url.Action("Index")" class="btn btn-secondary">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>