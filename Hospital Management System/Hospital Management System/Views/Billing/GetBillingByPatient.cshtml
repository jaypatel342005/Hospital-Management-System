@model List<EnhancedBillingModel>

<div class="pagetitle">
    <h1>Patient Billing Records</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/Dashboard">Home</a></li>
            <li class="breadcrumb-item"><a href="/Billing/Index">Billing</a></li>
            <li class="breadcrumb-item active">Patient: @(Model.Any() ? Model.First().PatientName : "Unknown")</li>
        </ol>
    </nav>
</div><!-- End Page Title -->

<section class="section">
    <div class="row">
        <div class="col-lg-12">

            @if (Model.Any())
            {
                <!-- Patient Info Card -->
                <div class="card mb-4">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="bi bi-person me-2"></i>
                            Patient Information
                        </h5>
                        <div class="row">
                            <div class="col-md-6">
                                <p><strong>Patient ID:</strong> #@Model.First().PatientID</p>
                                <p><strong>Patient Name:</strong> @Model.First().PatientName</p>
                            </div>
                            <div class="col-md-6">
                                <p><strong>Total Appointments:</strong> @Model.Count()</p>
                                <p><strong>Last Visit:</strong> @Model.Max(x => x.AppointmentDate).ToString("dd MMM yyyy")</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Summary Cards -->
                <div class="row mb-4">
                    <div class="col-xxl-4 col-md-4">
                        <div class="card info-card sales-card">
                            <div class="card-body">
                                <h5 class="card-title">Total Bills</h5>
                                <div class="d-flex align-items-center">
                                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                        <i class="bi bi-receipt"></i>
                                    </div>
                                    <div class="ps-3">
                                        <h6>₹@Model.Sum(x => x.BillAmount).ToString("N2")</h6>
                                        <span class="text-muted small pt-2 ps-1">@Model.Count() Bill(s)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xxl-4 col-md-4">
                        <div class="card info-card revenue-card">
                            <div class="card-body">
                                <h5 class="card-title">Total Paid</h5>
                                <div class="d-flex align-items-center">
                                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                        <i class="bi bi-check-circle"></i>
                                    </div>
                                    <div class="ps-3">
                                        <h6>₹@Model.Sum(x => x.PaidAmount).ToString("N2")</h6>
                                        <span class="text-success small pt-2 ps-1">Received</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-xxl-4 col-md-4">
                        <div class="card info-card customers-card">
                            <div class="card-body">
                                <h5 class="card-title">Outstanding</h5>
                                <div class="d-flex align-items-center">
                                    <div class="card-icon rounded-circle d-flex align-items-center justify-content-center">
                                        <i class="bi bi-exclamation-triangle"></i>
                                    </div>
                                    <div class="ps-3">
                                        <h6>₹@Model.Sum(x => x.BalanceAmount).ToString("N2")</h6>
                                        <span class="text-danger small pt-2 ps-1">Pending</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Billing Table -->
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="bi bi-file-earmark-text me-2"></i>
                            Billing History - @Model.First().PatientName
                        </h5>

                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle">
                                <thead class="table-dark">
                                    <tr>
                                        <th scope="col" class="text-center">#</th>
                                        <th scope="col" class="text-center">Bill ID</th>
                                        <th scope="col">Doctor</th>
                                        <th scope="col">Appointment</th>
                                        <th scope="col" class="text-end">Bill Amount</th>
                                        <th scope="col" class="text-end">Paid Amount</th>
                                        <th scope="col" class="text-end">Balance</th>
                                        <th scope="col" class="text-center">Status</th>
                                        <th scope="col" class="text-center">Date</th>
                                        <th scope="col" class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int counter = 1;
                                    }
                                    @foreach (var bill in Model.OrderByDescending(x => x.AppointmentDate))
                                    {
                                        <tr>
                                            <td class="text-center fw-bold">@counter</td>
                                            <td class="text-center">
                                                <span class="badge bg-light text-dark border">#@bill.BillID</span>
                                            </td>
                                            <td>
                                                <strong>@bill.DoctorName</strong>
                                            </td>
                                            <td>
                                                <small class="text-muted">
                                                    @bill.AppointmentDate.ToString("dd MMM yyyy hh:mm tt")
                                                </small>
                                                <br>
                                                <small class="text-primary">@bill.AppointmentDescription</small>
                                            </td>
                                            <td class="text-end fw-semibold">₹@bill.BillAmount.ToString("N2")</td>
                                            <td class="text-end text-success fw-semibold">₹@bill.PaidAmount.ToString("N2")</td>
                                            <td class="text-end">
                                                <span class="@(bill.BalanceAmount > 0 ? "text-danger fw-bold" : "text-success fw-bold")">
                                                    ₹@bill.BalanceAmount.ToString("N2")
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                @if (bill.PaymentStatus == "Paid")
                                                {
                                                    <span class="badge bg-success rounded-pill">
                                                        <i class="bi bi-check-circle me-1"></i>Paid
                                                    </span>
                                                }
                                                else if (bill.PaymentStatus == "Partial")
                                                {
                                                    <span class="badge bg-warning text-dark rounded-pill">
                                                        <i class="bi bi-clock me-1"></i>Partial
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger rounded-pill">
                                                        <i class="bi bi-x-circle me-1"></i>Pending
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <small class="text-muted fw-medium">
                                                    @bill.CreatedDate.ToString("dd MMM yyyy")
                                                </small>
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <a href="/Billing/Details/@bill.BillID"
                                                       class="btn btn-outline-primary"
                                                       data-bs-toggle="tooltip"
                                                       data-bs-placement="top"
                                                       title="View Details">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    @if (bill.BalanceAmount > 0)
                                                    {
                                                        <button class="btn btn-outline-success"
                                                                onclick="recordPayment(@bill.BillID, @bill.BalanceAmount)"
                                                                data-bs-toggle="tooltip"
                                                                data-bs-placement="top"
                                                                title="Record Payment">
                                                            <i class="bi bi-credit-card"></i>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                        counter++;
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr class="fw-bold">
                                        <td colspan="4" class="text-end">Totals:</td>
                                        <td class="text-end text-primary">₹@Model.Sum(x => x.BillAmount).ToString("N2")</td>
                                        <td class="text-end text-success">₹@Model.Sum(x => x.PaidAmount).ToString("N2")</td>
                                        <td class="text-end text-danger">₹@Model.Sum(x => x.BalanceAmount).ToString("N2")</td>
                                        <td colspan="3"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                    </div>
                </div>
            }
            else
            {
                <!-- No Data Alert -->
                <div class="card">
                    <div class="card-body">
                        <div class="alert alert-info d-flex align-items-center" role="alert">
                            <i class="bi bi-info-circle flex-shrink-0 me-2"></i>
                            <div>
                                No billing records found for this patient.
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Action Buttons -->
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                      
                        <a href="/Billing/Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Back to All Bills
                        </a>

                        @if (Model.Any())
                        {
                            <div class="btn-group">
                               
                                <button type="button" class="btn btn-outline-primary" onclick="printBills()">
                                    <i class="bi bi-printer me-1"></i> Print
                                </button>
                                <button type="button" class="btn btn-outline-success" onclick="exportToExcel()">
                                    <i class="bi bi-file-earmark-excel me-1"></i> Export
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Payment Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-credit-card me-2"></i>Record Payment
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="paymentForm">
                    <input type="hidden" id="billId" name="billId">
                    <div class="mb-3">
                        <label for="paymentAmount" class="form-label fw-semibold">Payment Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input type="number" class="form-control" id="paymentAmount"
                                   name="paymentAmount" step="0.01" min="0.01" required>
                        </div>
                        <div class="form-text">Outstanding balance will be shown here</div>
                    </div>
                    <div class="mb-3">
                        <label for="paymentMethod" class="form-label fw-semibold">Payment Method</label>
                        <select class="form-select" id="paymentMethod" name="paymentMethod" required>
                            <option value="">Select Payment Method</option>
                            <option value="Cash">Cash</option>
                            <option value="Card">Card</option>
                            <option value="UPI">UPI</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="remarks" class="form-label fw-semibold">Remarks (Optional)</label>
                        <textarea class="form-control" id="remarks" name="remarks" rows="2"
                                  placeholder="Add any additional notes..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg me-1"></i>Cancel
                </button>
                <button type="button" class="btn btn-success" onclick="processPayment()">
                    <i class="bi bi-check-circle me-1"></i> Record Payment
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // Initialize tooltips
    document.addEventListener('DOMContentLoaded', function() {
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    });

    function recordPayment(billId, maxAmount) {
        document.getElementById('billId').value = billId;
        document.getElementById('paymentAmount').setAttribute('max', maxAmount);
        document.getElementById('paymentAmount').value = maxAmount;
        document.querySelector('.form-text').textContent = `Outstanding balance: ₹${maxAmount.toFixed(2)}`;
        
        const modal = new bootstrap.Modal(document.getElementById('paymentModal'));
        modal.show();
    }

    function processPayment() {
        const form = document.getElementById('paymentForm');
        const formData = new FormData(form);

        if (form.checkValidity()) {
            const billId = formData.get('billId');
            const amount = formData.get('paymentAmount');
            
            // Redirect to payment processing
            window.location.href = `/Billing/RecordPayment?BillID=${billId}&PaymentAmount=${amount}`;
        } else {
            form.reportValidity();
        }
    }

    function printBills() {
        window.print();
    }

    function exportToExcel() {
        const patientId = @(Model.Any() ? Model.First().PatientID : 0);
        window.location.href = `/Billing/ExportToExcel?PatientID=${patientId}`;
    }
</script>