@using System.Data
@model DataTable

@{
    ViewData["Title"] = "Bill Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var billingData = (DataTable)Model;
    var billingRow = billingData.Rows[0];
    var appointmentTable = (DataTable)ViewData["AppointmentTable"];
    var patientTable = (DataTable)ViewData["PatientTable"];
    var doctorTable = (DataTable)ViewData["DoctorTable"];
    var paymentHistoryTable = (DataTable)ViewData["PaymentHistoryTable"];
    var otherBillsTable = (DataTable)ViewData["OtherBillsTable"];
    var medicalRecordsTable = (DataTable)ViewData["MedicalRecordsTable"];
    var doctorDepartmentTable = (DataTable)ViewData["DoctorDepartmentTable"];

    decimal billAmount = Convert.ToDecimal(billingRow["BillAmount"]);
    decimal paidAmount = Convert.ToDecimal(billingRow["PaidAmount"]);
    decimal balanceAmount = Convert.ToDecimal(ViewData["BalanceAmount"]);
    decimal subtotal = Convert.ToDecimal(ViewData["Subtotal"]);
    decimal taxAmount = Convert.ToDecimal(ViewData["TaxAmount"]);
    string paymentStatus = billingRow["PaymentStatus"].ToString();

    string statusBadgeClass = paymentStatus switch
    {
        "Paid" => "bg-success",
        "Partial" => "bg-warning",
        "Unpaid" => "bg-danger",
        _ => "bg-secondary"
    };
}

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Page Title -->
<div class="pagetitle">
    <h1>Bill Details</h1>
    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item"><a href="/Billing">Billing</a></li>
            <li class="breadcrumb-item active">Bill Details</li>
        </ol>
    </nav>
</div>

<section class="section">
    <div class="row">
        <!-- Main Bill Details Card -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-receipt-cutoff me-2"></i>Bill Details
                    </h5>
                    <div class="d-flex gap-2">
                        <span class="badge @statusBadgeClass" id="billStatus">@paymentStatus</span>
                        <button class="btn btn-sm btn-outline-primary" onclick="printBill()">
                            <i class="bi bi-printer me-1"></i>Print
                        </button>
                        <button class="btn btn-sm btn-outline-success" onclick="downloadPDF()">
                            <i class="bi bi-download me-1"></i>Download PDF
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Bill Header -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h6 class="text-primary">Bill Information</h6>
                            <table class="table table-sm table-borderless">
                                <tr>
                                    <td class="fw-bold">Bill ID:</td>
                                    <td id="billId">BL-@billingRow["BillID"]</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Bill Date:</td>
                                    <td id="billDate">@Convert.ToDateTime(billingRow["CreatedDate"]).ToString("dd MMM yyyy")</td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Appointment ID:</td>
                                    <td>APT-@billingRow["AppointmentID"]</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-primary">Patient Information</h6>
                            <table class="table table-sm table-borderless">
                                @if (patientTable != null && patientTable.Rows.Count > 0)
                                {
                                    var patientRow = patientTable.Rows[0];
                                    <tr>
                                        <td class="fw-bold">Name:</td>
                                        <td id="patientName">@patientRow["Name"]</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Patient ID:</td>
                                        <td id="patientId">PT-@patientRow["PatientID"]</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Contact:</td>
                                        <td id="patientPhone">@patientRow["Phone"]</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-bold">Age:</td>
                                        <td>@ViewData["PatientAge"] years</td>
                                    </tr>
                                }
                            </table>
                        </div>
                    </div>

                    <!-- Bill Items -->
                    <div class="mb-4">
                        <h6 class="text-primary mb-3">Bill Breakdown</h6>
                        <div class="table-responsive">
                            <table class="table table-striped" id="billItemsTable">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Description</th>
                                        <th>Details</th>
                                        <th>Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (appointmentTable != null && appointmentTable.Rows.Count > 0 && doctorTable != null && doctorTable.Rows.Count > 0)
                                    {
                                        var appointmentRow = appointmentTable.Rows[0];
                                        var doctorRow = doctorTable.Rows[0];
                                        var consultationFee = subtotal;

                                        <tr>
                                            <td>
                                                <strong>Consultation Fee</strong>
                                                <br><small class="text-muted">@doctorRow["Name"] - @doctorRow["Specialization"]</small>
                                            </td>
                                            <td>
                                                <small class="text-muted">
                                                    Date: @Convert.ToDateTime(appointmentRow["AppointmentDate"]).ToString("dd MMM yyyy HH:mm")
                                                    <br>Description: @appointmentRow["Description"]
                                                </small>
                                            </td>
                                            <td>₹@consultationFee.ToString("N2")</td>
                                        </tr>
                                    }

                                    @if (medicalRecordsTable != null && medicalRecordsTable.Rows.Count > 0)
                                    {
                                        <tr>
                                            <td>
                                                <strong>Medical Services</strong>
                                                <br><small class="text-muted">Diagnosis & Treatment</small>
                                            </td>
                                            <td>
                                                <small class="text-muted">
                                                    @foreach (DataRow record in medicalRecordsTable.Rows)
                                                    {
                                                        <div class="mb-1">
                                                            <strong>@record["Diagnosis"]</strong>
                                                            @if (!string.IsNullOrEmpty(record["Treatment"].ToString()))
                                                            {
                                                            <br>
                                                           
                                                                                                                }
                                                        </div>
                                                    }
                                                </small>
                                            </td>
                                            <td>Included</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Bill Summary -->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="text-primary mb-3">Payment Summary</h6>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Subtotal:</span>
                                        <span id="subtotal">₹@subtotal.ToString("N2")</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Tax (10%):</span>
                                        <span id="tax">₹@taxAmount.ToString("N2")</span>
                                    </div>
                                    <hr>
                                    <div class="d-flex justify-content-between fw-bold fs-5 text-primary">
                                        <span>Total Amount:</span>
                                        <span id="totalAmount">₹@billAmount.ToString("N2")</span>
                                    </div>
                                    <div class="d-flex justify-content-between mt-2">
                                        <span>Amount Paid:</span>
                                        <span id="amountPaid" class="text-success">₹@paidAmount.ToString("N2")</span>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span>Outstanding:</span>
                                        <span id="outstanding" class="@(balanceAmount > 0 ? "text-danger" : "text-success")">₹@balanceAmount.ToString("N2")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="text-primary mb-3">Quick Actions</h6>
                                    <div class="d-grid gap-2">
                                        @if (balanceAmount > 0)
                                        {
                                            <button class="btn btn-success" onclick="processPayment()" id="payBtn">
                                                <i class="bi bi-credit-card me-2"></i>Process Payment
                                            </button>
                                        }
                                        <button class="btn btn-warning" onclick="applyDiscount()">
                                            <i class="bi bi-percent me-2"></i>Apply Discount
                                        </button>
                                        <a href="/Billing/Edit/@billingRow["BillID"]" class="btn btn-secondary">
                                            <i class="bi bi-pencil me-2"></i>Edit Bill
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Payment History Card -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-clock-history me-2"></i>Payment History
                    </h5>
                </div>
                <div class="card-body">
                    <div class="timeline" id="paymentHistory">
                        @if (paymentHistoryTable != null && paymentHistoryTable.Rows.Count > 0)
                        {
                            foreach (DataRow history in paymentHistoryTable.Rows)
                            {
                                string markerClass = history["ActionType"].ToString() == "Payment" ? "bg-success" : "bg-info";
                                <div class="timeline-item">
                                    <div class="timeline-marker @markerClass"></div>
                                    <div class="timeline-content">
                                        <h6 class="mb-1">@history["ActionType"]</h6>
                                        <p class="mb-1 text-muted">Amount: ₹@Convert.ToDecimal(history["Amount"]).ToString("N2")</p>
                                        <small class="text-muted">@Convert.ToDateTime(history["ActionDate"]).ToString("dd MMM yyyy, HH:mm")</small>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="timeline-item">
                                <div class="timeline-marker bg-info"></div>
                                <div class="timeline-content">
                                    <h6 class="mb-1">Bill Generated</h6>
                                    <p class="mb-1 text-muted">Total: ₹@billAmount.ToString("N2")</p>
                                    <small class="text-muted">@Convert.ToDateTime(billingRow["CreatedDate"]).ToString("dd MMM yyyy, HH:mm")</small>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Related Information Card -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-info-circle me-2"></i>Related Information
                    </h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item px-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <span>Appointment ID:</span>
                                <span class="badge bg-primary">APT-@billingRow["AppointmentID"]</span>
                            </div>
                        </div>
                        @if (doctorDepartmentTable != null && doctorDepartmentTable.Rows.Count > 0)
                        {
                            var deptRow = doctorDepartmentTable.Rows[0];
                            <div class="list-group-item px-0">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span>Department:</span>
                                    <span>@deptRow["DepartmentName"]</span>
                                </div>
                            </div>
                        }
                        @if (doctorTable != null && doctorTable.Rows.Count > 0)
                        {
                            var doctorRow = doctorTable.Rows[0];
                            <div class="list-group-item px-0">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span>Doctor:</span>
                                    <span>@doctorRow["Name"]</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Outstanding Bills Card -->
            @if (otherBillsTable != null && otherBillsTable.Rows.Count > 0)
            {
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="card-title mb-0">
                            <i class="bi bi-exclamation-triangle me-2"></i>Other Outstanding Bills
                        </h5>
                    </div>
                    <div class="card-body">
                        @foreach (DataRow otherBill in otherBillsTable.Rows)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div>
                                    <small><strong>BL-@otherBill["BillID"]</strong></small>
                                    <br><small class="text-muted">@otherBill["DoctorName"]</small>
                                </div>
                                <div class="text-end">
                                    <small class="text-danger">₹@Convert.ToDecimal(otherBill["BalanceAmount"]).ToString("N2")</small>
                                    <br><small class="badge bg-warning">@otherBill["PaymentStatus"]</small>
                                </div>
                            </div>
                            <hr class="my-2">
                        }
                        <a href="/Billing/GetBillingByPatient?PatientID=@billingRow["PatientID"]" class="btn btn-sm btn-outline-primary w-100">
                            View All Patient Bills
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Payment Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1" aria-labelledby="paymentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="paymentModalLabel">
                    <i class="bi bi-credit-card me-2"></i>Process Payment
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="paymentForm">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="paymentAmount" class="form-label">Payment Amount</label>
                                <input type="number" class="form-control" id="paymentAmount" value="@balanceAmount.ToString("F2")" step="0.01" max="@balanceAmount.ToString("F2")">
                                <small class="text-muted">Outstanding: ₹@balanceAmount.ToString("N2")</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="paymentMethod" class="form-label">Payment Method</label>
                                <select class="form-select" id="paymentMethodSelect">
                                    <option value="card">Credit/Debit Card</option>
                                    <option value="cash">Cash</option>
                                    <option value="insurance">Insurance</option>
                                    <option value="bank">Bank Transfer</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="paymentNotes" class="form-label">Payment Notes</label>
                        <textarea class="form-control" id="paymentNotes" rows="3" placeholder="Additional notes..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" onclick="confirmPayment()">
                    <i class="bi bi-check-circle me-2"></i>Process Payment
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Discount Modal -->
<div class="modal fade" id="discountModal" tabindex="-1" aria-labelledby="discountModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="discountModalLabel">
                    <i class="bi bi-percent me-2"></i>Apply Discount
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="discountForm">
                    <div class="mb-3">
                        <label for="discountType" class="form-label">Discount Type</label>
                        <select class="form-select" id="discountType">
                            <option value="percentage">Percentage</option>
                            <option value="fixed">Fixed Amount</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="discountValue" class="form-label">Discount Value</label>
                        <input type="number" class="form-control" id="discountValue" step="0.01">
                        <small class="text-muted">Current Bill Amount: ₹@billAmount.ToString("N2")</small>
                    </div>
                    <div class="mb-3">
                        <label for="discountReason" class="form-label">Reason</label>
                        <textarea class="form-control" id="discountReason" rows="2" placeholder="Reason for discount..." required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" onclick="applyDiscountConfirm()">
                    <i class="bi bi-check-circle me-2"></i>Apply Discount
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .timeline {
        position: relative;
        padding-left: 30px;
    }

    .timeline-item {
        position: relative;
        padding-bottom: 20px;
    }

        .timeline-item:before {
            content: '';
            position: absolute;
            left: -22px;
            top: 8px;
            bottom: -12px;
            width: 2px;
            background-color: #e9ecef;
        }

        .timeline-item:last-child:before {
            display: none;
        }

    .timeline-marker {
        position: absolute;
        left: -27px;
        top: 6px;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        border: 2px solid #fff;
        box-shadow: 0 0 0 2px #e9ecef;
    }

    .timeline-content h6 {
        margin-bottom: 5px;
        color: #333;
    }

    .badge {
        font-size: 0.85em;
    }

    .table-responsive {
        border-radius: 5px;
        overflow: hidden;
    }

    @@media print {
        .btn, .modal, .card-header .d-flex .gap-2

    {
        display: none !important;
    }

    .card {
        border: none !important;
        box-shadow: none !important;
    }

    body {
        background: white !important;
    }

    }
</style>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const billId = @billingRow["BillID"];

        // Payment processing functionality
        function processPayment() {
            const outstandingText = document.getElementById('outstanding').textContent.replace('₹', '').replace(',', '');
            const outstanding = parseFloat(outstandingText);

            if (outstanding > 0) {
                const paymentModal = new bootstrap.Modal(document.getElementById('paymentModal'));
                paymentModal.show();
            } else {
                Swal.fire({
                    title: 'Payment Complete',
                    text: 'This bill has already been paid in full.',
                    icon: 'info',
                    confirmButtonText: 'OK'
                });
            }
        }

        function confirmPayment() {
            const amount = parseFloat(document.getElementById('paymentAmount').value);
            const method = document.getElementById('paymentMethodSelect').value;
            const notes = document.getElementById('paymentNotes').value;

            if (!amount || amount <= 0) {
                Swal.fire({
                    title: 'Invalid Amount',
                    text: 'Please enter a valid payment amount.',
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
                return;
            }

            const outstandingText = document.getElementById('outstanding').textContent.replace('₹', '').replace(',', '');
            const outstanding = parseFloat(outstandingText);

            if (amount > outstanding) {
                Swal.fire({
                    title: 'Amount Exceeds Outstanding',
                    text: `Payment amount cannot exceed outstanding balance of ₹{outstanding.toFixed(2)}`,
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
                return;
            }

            // Show processing indicator
            Swal.fire({
                title: 'Processing Payment...',
                text: 'Please wait while we process your payment.',
                icon: 'info',
                allowOutsideClick: false,
                showConfirmButton: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // Create form data for POST request
            const formData = new FormData();
            formData.append('BillID', billId);
            formData.append('PaymentAmount', amount);

            // Make request to RecordPayment action
            fetch('/Billing/RecordPayment', {
                method: 'POST',
                body: formData
            })
            .then(response => {
                if (response.ok) {
                    // Success - redirect will happen automatically due to RedirectToAction
                    Swal.fire({
                        title: 'Payment Successful!',
                        text: 'Payment has been recorded successfully.',
                        icon: 'success',
                        confirmButtonText: 'OK'
                    }).then(() => {
                        // Refresh the page to show updated information
                        window.location.reload();
                    });
                } else {
                    throw new Error('Payment failed');
                }
            })
            .catch(error => {
                Swal.fire({
                    title: 'Payment Failed',
                    text: 'An error occurred while processing the payment. Please try again.',
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
            });

            // Close modal
            bootstrap.Modal.getInstance(document.getElementById('paymentModal')).hide();
        }

        function applyDiscount() {
            const discountModal = new bootstrap.Modal(document.getElementById('discountModal'));
            discountModal.show();
        }

        function applyDiscountConfirm() {
            const discountType = document.getElementById('discountType').value;
            const discountValue = parseFloat(document.getElementById('discountValue').value);
            const reason = document.getElementById('discountReason').value.trim();

            if (!discountValue || discountValue <= 0) {
                Swal.fire({
                    title: 'Invalid Discount',
                    text: 'Please enter a valid discount value.',
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
                return;
            }

            if (!reason) {
                Swal.fire({
                    title: 'Reason Required',
                    text: 'Please provide a reason for the discount.',
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
                return;
            }

            // Show processing indicator
            Swal.fire({
                title: 'Applying Discount...',
                text: 'Please wait while we apply the discount.',
                icon: 'info',
                allowOutsideClick: false,
                showConfirmButton: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // Create form data for POST request
            const formData = new FormData();
            formData.append('BillID', billId);
            formData.append('DiscountType', discountType);
            formData.append('DiscountValue', discountValue);
            formData.append('Reason', reason);

            // Make AJAX call to apply discount
            fetch('/Billing/ApplyDiscount', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    bootstrap.Modal.getInstance(document.getElementById('discountModal')).hide();

                    Swal.fire({
                        title: 'Discount Applied!',
                        text: `Discount of ₹{data.discountAmount.toFixed(2)} has been applied. New bill amount: ₹{data.newBillAmount.toFixed(2)}`,
                        icon: 'success',
                        confirmButtonText: 'OK'
                    }).then(() => {
                        // Refresh the page to show updated information
                        window.location.reload();
                    });
                } else {
                    Swal.fire({
                        title: 'Discount Failed',
                        text: data.message || 'Failed to apply discount.',
                        icon: 'error',
                        confirmButtonText: 'OK'
                    });
                }
            })
            .catch(error => {
                Swal.fire({
                    title: 'Error',
                    text: 'An error occurred while applying the discount.',
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
            });
        }



        function printBill() {
            window.print();
        }

        function downloadPDF() {
            Swal.fire({
                title: 'Generating PDF...',
                text: 'Please wait while we generate your PDF.',
                icon: 'info',
                allowOutsideClick: false,
                showConfirmButton: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            setTimeout(() => {
                Swal.fire({
                    title: 'PDF Generated!',
                    text: 'Your PDF has been downloaded successfully.',
                    icon: 'success',
                    confirmButtonText: 'OK'
                });

                // Simulate PDF download - you can replace this with actual PDF generation endpoint
                const link = document.createElement('a');
                link.href = `/Billing/DownloadPDF/₹{billId}`;
                link.download = `bill-BL-₹{billId}.pdf`;
                link.click();
            }, 2000);
        }

        // Payment method selector
        document.getElementById('paymentMethodSelect').addEventListener('change', function() {
            // You can add specific logic for different payment methods here
            if (this.value === 'insurance') {
                // Could show additional fields for insurance claims
                console.log('Insurance payment selected');
            }
        });

        // Numeric input validation
        document.getElementById('paymentAmount').addEventListener('input', function(e) {
            let value = parseFloat(e.target.value);
            let max = parseFloat(e.target.max);

            if (value > max) {
                e.target.value = max;
                Swal.fire({
                    title: 'Amount Exceeds Limit',
                    text: `Payment amount cannot exceed the outstanding balance of ₹{max.toFixed(2)}`,
                    icon: 'warning',
                    confirmButtonText: 'OK'
                });
            }
        });

        document.getElementById('discountValue').addEventListener('input', function(e) {
            const discountType = document.getElementById('discountType').value;
            const currentBillAmount = @billAmount;
            let value = parseFloat(e.target.value);

            if (discountType === 'percentage' && value > 100) {
                e.target.value = 100;
                Swal.fire({
                    title: 'Invalid Percentage',
                    text: 'Percentage discount cannot exceed 100%',
                    icon: 'warning',
                    confirmButtonText: 'OK'
                });
            } else if (discountType === 'fixed' && value > currentBillAmount) {
                e.target.value = currentBillAmount;
                Swal.fire({
                    title: 'Discount Too High',
                    text: `Fixed discount cannot exceed the bill amount of ₹{currentBillAmount.toFixed(2)}`,
                    icon: 'warning',
                    confirmButtonText: 'OK'
                });
            }
        });

        // Initialize tooltips and other Bootstrap components
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize tooltips
            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            const tooltipList = tooltipTriggerList.map(function(tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Auto-dismiss alerts after 5 seconds
            const alerts = document.querySelectorAll('.alert-dismissible');
            alerts.forEach(function(alert) {
                setTimeout(function() {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }, 5000);
            });

            // Add form validation
            const paymentForm = document.getElementById('paymentForm');
            const discountForm = document.getElementById('discountForm');

            if (paymentForm) {
                paymentForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    confirmPayment();
                });
            }

            if (discountForm) {
                discountForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    applyDiscountConfirm();
                });
            }
        });

        // Keyboard shortcuts
        document.addEventListener('keydown', function(e) {
            // Ctrl/Cmd + P for print
            if ((e.ctrlKey || e.metaKey) && e.key === 'p') {
                e.preventDefault();
                printBill();
            }

            // Ctrl/Cmd + D for download
            if ((e.ctrlKey || e.metaKey) && e.key === 'd') {
                e.preventDefault();
                downloadPDF();
            }

            // Escape to close modals
            if (e.key === 'Escape') {
                const openModals = document.querySelectorAll('.modal.show');
                openModals.forEach(modal => {
                    bootstrap.Modal.getInstance(modal).hide();
                });
            }
        });

        // Auto-save payment notes as user types (with debouncing)
        let notesSaveTimeout;
        document.getElementById('paymentNotes').addEventListener('input', function() {
            clearTimeout(notesSaveTimeout);
            notesSaveTimeout = setTimeout(() => {
                // Could save to local storage or make AJAX call to save draft
                console.log('Auto-saving payment notes...');
            }, 1000);
        });

        // Format currency inputs
        function formatCurrency(input) {
            let value = input.value.replace(/[^\d.]/g, '');
            let parts = value.split('.');
            if (parts.length > 2) {
                value = parts[0] + '.' + parts.slice(1).join('');
            }
            if (parts[1] && parts[1].length > 2) {
                value = parts[0] + '.' + parts[1].substring(0, 2);
            }
            input.value = value;
        }

        // Apply currency formatting to amount inputs
        document.getElementById('paymentAmount').addEventListener('blur', function() {
            formatCurrency(this);
        });

        document.getElementById('discountValue').addEventListener('blur', function() {
            if (document.getElementById('discountType').value === 'fixed') {
                formatCurrency(this);
            }
        });

        // Real-time discount calculation preview
        function updateDiscountPreview() {
            const discountType = document.getElementById('discountType').value;
            const discountValue = parseFloat(document.getElementById('discountValue').value) || 0;
            const currentBillAmount = @billAmount;

            let discountAmount = 0;
            if (discountType === 'percentage') {
                discountAmount = (currentBillAmount * discountValue) / 100;
            } else {
                discountAmount = discountValue;
            }

            const newAmount = currentBillAmount - discountAmount;

            // Update preview text
            const previewText = document.getElementById('discountPreview');
            if (previewText) {
                previewText.textContent = `Preview: Discount ₹{discountAmount.toFixed(2)}, New Amount: ₹{newAmount.toFixed(2)}`;
            }
        }

        document.getElementById('discountType').addEventListener('change', updateDiscountPreview);
        document.getElementById('discountValue').addEventListener('input', updateDiscountPreview);
    </script>
}